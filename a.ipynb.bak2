    "# ===== Exercise 2.2 — as quatro fontes ligam uma para uma? =====\n",
    "import os, glob\n",
    "\n",
    "MEDIA = 'dataset/dataset'\n",
    "\n",
    "# --- a tabela contra ela propria ---\n",
    "print(\"metadata: {} linhas | {} Audio_Song unicos | {} Lyric_Song unicos\".format(\n",
    "    len(df_metadata), df_metadata['Audio_Song'].nunique(), df_metadata['Lyric_Song'].nunique()))\n",
    "print(\"linhas com Audio_Song repetido:\", int(df_metadata['Audio_Song'].duplicated().sum()))\n",
    "a2l = df_metadata.groupby('Audio_Song')['Lyric_Song'].nunique().max()\n",
    "l2a = df_metadata.groupby('Lyric_Song')['Audio_Song'].nunique().max()\n",
    "print(\"Audio_Song <-> Lyric_Song e 1:1?\", bool(a2l == 1 and l2a == 1))\n",
    "\n",
    "# --- a tabela contra as pastas de media ---\n",
    "audio_ids = {os.path.splitext(os.path.basename(p))[0] for p in glob.glob(f'{MEDIA}/audio/*/*.mp3')}\n",
    "lyric_ids = {os.path.splitext(os.path.basename(p))[0] for p in glob.glob(f'{MEDIA}/lyrics/*/*.txt')}\n",
    "cover_ids = {os.path.splitext(os.path.basename(p))[0] for p in glob.glob(f'{MEDIA}/album_covers/*/*.jpg')}\n",
    "songs_a = set(df_metadata['Audio_Song'])\n",
    "songs_l = set(df_metadata['Lyric_Song'])\n",
    "\n",
    "join = pd.DataFrame([\n",
    "    {'fonte': 'audio', 'chave': 'Audio_Song', 'ficheiros': len(audio_ids),\n",
    "     'musicas com ficheiro': len(songs_a & audio_ids),\n",
    "     'ficheiros sem linha': len(audio_ids - songs_a),\n",
    "     'musicas sem ficheiro': len(songs_a - audio_ids)},\n",
    "    {'fonte': 'lyrics', 'chave': 'Lyric_Song', 'ficheiros': len(lyric_ids),\n",
    "     'musicas com ficheiro': len(songs_l & lyric_ids),\n",
    "     'ficheiros sem linha': len(lyric_ids - songs_l),\n",
    "     'musicas sem ficheiro': len(songs_l - lyric_ids)},\n",
    "    {'fonte': 'album_covers', 'chave': 'Audio_Song', 'ficheiros': len(cover_ids),\n",
    "     'musicas com ficheiro': len(songs_a & cover_ids),\n",
    "     'ficheiros sem linha': len(cover_ids - songs_a),\n",
    "     'musicas sem ficheiro': len(songs_a - cover_ids)},\n",
    "])\n",
    "print(\"\\nLigacao tabela <-> pastas de media:\")\n",
    "display(join)\n"
   ]
