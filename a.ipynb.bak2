   "source": [
    "#3.3\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import scipy.stats as ss\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.feature_selection import mutual_info_classif\n",
    "from collections import Counter\n",
    "\n",
    "def correlation_ratio(categories, measurements):\n",
    "    \"\"\"Calcula o Correlation Ratio (eta) para Numérico vs Categórico\"\"\"\n",
    "    fcat, _ = pd.factorize(categories)\n",
    "    cat_num = np.max(fcat) + 1\n",
    "    y_avg_array = np.zeros(cat_num)\n",
    "    n_array = np.zeros(cat_num)\n",
    "    \n",
    "    for i in range(0, cat_num):\n",
    "        cat_measures = measurements[np.argwhere(fcat == i).flatten()]\n",
    "        n_array[i] = len(cat_measures)\n",
    "        y_avg_array[i] = np.average(cat_measures) if len(cat_measures) > 0 else 0\n",
    "        \n",
    "    y_total_avg = np.average(measurements)\n",
    "    numerator = np.sum(n_array * np.power(y_avg_array - y_total_avg, 2))\n",
    "    denominator = np.sum(np.power(measurements - y_total_avg, 2))\n",
    "    \n",
    "    if denominator == 0:\n",
    "        return 0.0\n",
    "    return np.sqrt(numerator / denominator)\n",
    "\n",
    "def cramers_v(x, y):\n",
    "    confusion_matrix = pd.crosstab(x, y)\n",
    "    chi2 = ss.chi2_contingency(confusion_matrix)[0]\n",
    "    n = confusion_matrix.sum().sum()\n",
    "    phi2 = chi2 / n\n",
    "    r, k = confusion_matrix.shape\n",
    "    \n",
    "    phi2corr = max(0, phi2 - ((k-1)*(r-1))/(n-1))\n",
    "    rcorr = r - ((r-1)**2)/(n-1)\n",
    "    kcorr = k - ((k-1)**2)/(n-1)    \n",
    "    min_dim = min((kcorr-1), (rcorr-1))\n",
    "    if min_dim <= 0:\n",
    "        return 0.0\n",
    "        \n",
    "    return np.sqrt(phi2corr / min_dim)\n",
    "\n",
    "# Colunas de etiquetas (listas separadas por virgula): medir a string inteira com\n",
    "# Cramer's V nao faz sentido (cada string e quase unica, o que esconde a associacao).\n",
    "# Dividimos em etiquetas individuais e medimos a informacao mutua normalizada\n",
    "# (fracao da entropia do alvo explicada pelo conjunto de etiquetas). Assim a fuga\n",
    "# das etiquetas de humor/tema, usadas para construir o alvo, fica visivel.\n",
    "TAG_COLS = ['Moods', 'MoodsAll', 'Genres', 'Styles', 'Themes']\n",
    "\n",
    "def tag_association(series, target, top=50):\n",
    "    valid = series.notna() & target.notna()\n",
    "    tags = series[valid].astype(str).str.split(',').apply(lambda lst: [t.strip() for t in lst])\n",
    "    counts = Counter(t for lst in tags for t in lst if t)\n",
    "    keep = [t for t, _ in counts.most_common(top)]\n",
    "    if not keep:\n",
    "        return 0.0\n",
    "    X = pd.DataFrame({t: tags.apply(lambda lst: int(t in lst)) for t in keep})\n",
    "    y, _ = pd.factorize(target[valid])\n",
    "    mi = mutual_info_classif(X, y, discrete_features=True, random_state=0)\n",
    "    Hy = ss.entropy(np.bincount(y) / len(y))\n",
    "    if Hy == 0:\n",
    "        return 0.0\n",
    "    return float(min(mi.sum() / Hy, 1.0))\n",
    "\n",
    "target_col = 'Quadrant'\n",
    "results = {}\n",
    "\n",
    "cols_to_skip = [target_col, 'Audio_Song', 'Lyric_Song', 'AllMusic Id', 'Title', \n",
    "                'SampleURL', 'AppearancesTrackIDs', 'AppearancesAlbumIDs']\n",
    "\n",
    "for col in df_train.columns:\n",
    "    if col in cols_to_skip:\n",
    "        continue\n",
    "\n",
    "    # etiquetas multi-label: medir por etiqueta individual, nao pela string inteira\n",
    "    if col in TAG_COLS:\n",
    "        results[col] = tag_association(df_train[col], df_train[target_col])\n",
    "        continue\n",
    "\n",
    "    valid_data = df_train[[col, target_col]].dropna()\n",
    "    \n",
    "    if len(valid_data) == 0 or valid_data[col].nunique() <= 1:\n",
    "        results[col] = 0.0\n",
    "        continue\n",
    "        \n",
    "    if pd.api.types.is_numeric_dtype(valid_data[col]):\n",
    "        score = correlation_ratio(valid_data[target_col].values, valid_data[col].values)\n",
    "    else:\n",
    "        score = cramers_v(valid_data[col], valid_data[target_col])\n",
    "        \n",
    "    results[col] = score\n",
    "\n",
    "assoc_df = pd.DataFrame.from_dict(results, orient='index', columns=['Association Score'])\n",
    "assoc_df = assoc_df.sort_values(by='Association Score', ascending=False)\n",
    "\n",
    "plt.figure(figsize=(12, 8))\n",
    "sns.barplot(x=assoc_df['Association Score'], y=assoc_df.index, hue=assoc_df.index, palette='magma', legend=False)\n",
    "plt.title(\"3.3 — Associação de cada Característica com o Alvo (Quadrant)\")\n",
    "plt.xlabel(\"Score de Associação (0 a 1)\")\n",
    "plt.ylabel(\"Características\")\n",
    "plt.xlim(0, 1.1)\n",
    "plt.axvline(x=0.8, color='red', linestyle='--', label='Associação Crítica (>0.8)')\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "display(assoc_df.head(10))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5c321e8f",
   "metadata": {},
   "source": [
    "### 3.3 & 3.4 - Association Measurement and Target Leakage Analysis\n",
    "\n",
    "**3.3 Measure how well each column alone predicts the quadrant.**\n",
    "As shown in the bar chart above, Valence (0.95) and Arousal (0.85) possess an almost perfect association with the target Quadrant. This extreme association is expected, as these two variables mathematically define the quadrants themselves. Once the tag lists are split into individual tags rather than measured as whole strings, the metadata tags Moods, MoodsAll and Themes reach the top of the ranking (≈1.00), followed by Styles (0.90), confirming they predict the quadrant far too well; Genres (0.45) and Artist (0.46) are much lower, and Genres' earlier apparent strength was only an artefact of measuring the raw comma-separated string. Regardless of the mathematical scores, the mechanism by which the target reached the Moods and Themes columns is intrinsic to the dataset creation process (mapping AllMusic tags to valence and arousal). Therefore, these metadata fields, along with Valence and Arousal, are not predictive features; they are the source code of the labels themselves.\n",
    "\n",
    "**3.4 Compare 3.3 with the list of 2.3. What proportion was obtainable by reading alone?**\n",
    "Comparing the mathematical results of Section 3.3 with our preliminary assessment in Section 2.3, 100% of the severe target leakage (Valence and Arousal) was obtainable by reading alone. Before running any code, the documentation explicitly stated the labeling methodology. This allowed us to successfully predict in Section 2.3 that Valence, Arousal, Moods, MoodsAll, and Themes would artificially give away the target (as they were used to compute the ground truth). Once the tag lists are measured per individual tag, the mood and theme tags show the strongest associations, and these core variables responsible for the methodological target leakage were entirely identified simply by reading the documentation. These variables must be discarded from the input space for the machine learning pipeline."
   ]
  },
