   "source": [
    "# ===== Exercise 3.1, 3.2, 3.5 =====\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import numpy as np\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# Auxiliares\n",
    "# ------------------------------------------------------------------\n",
    "def split_tags(series):\n",
    "    \"\"\"Colunas multi-etiqueta (listas separadas por virgula) -> uma etiqueta por linha.\"\"\"\n",
    "    return (series.dropna().astype(str).str.split(',')\n",
    "            .explode().str.strip().replace('', np.nan).dropna())\n",
    "\n",
    "def parse_year(series):\n",
    "    \"\"\"Extrai um ano de 4 digitos de colunas de data guardadas como texto.\"\"\"\n",
    "    return pd.to_numeric(\n",
    "        series.astype('string').str.extract(r'((?:18|19|20|21)\\d{2})', expand=False),\n",
    "        errors='coerce')\n",
    "\n",
    "TAG_COLS  = ['Moods', 'MoodsAll', 'Genres', 'Styles', 'Themes']\n",
    "YEAR_COLS = ['Year', 'LowestYear', 'ActualYear']\n",
    "ID_COLS   = ['Audio_Song', 'Lyric_Song', 'AllMusic Id', 'Title',\n",
    "             'SampleURL', 'AppearancesTrackIDs', 'AppearancesAlbumIDs']\n",
    "\n",
    "# ==================================================================\n",
    "# 3.1 - Descrever todas as colunas: tipo, em falta, intervalo/distribuicao\n",
    "# ==================================================================\n",
    "\n",
    "# Tabela unica pedida: tipo, taxa de valores em falta, unicos e associacao com o alvo (de 3.3)\n",
    "resume_df = pd.DataFrame({\n",
    "    'Type': df_train.dtypes,\n",
    "    'Missing (%)': df_train.isnull().mean() * 100,\n",
    "    'Unique Values': df_train.nunique()\n",
    "})\n",
    "try:\n",
    "    resume_df = resume_df.join(assoc_df.rename(columns={'Association Score': 'Assoc. target'}))\n",
    "except NameError:\n",
    "    print(\"(assoc_df de 3.3 ainda nao existe: corre a celula 3.3 primeiro)\")\n",
    "\n",
    "print(\"3.1 - Resumo de todas as colunas\")\n",
    "display(resume_df.sort_values('Missing (%)', ascending=False).round(3))\n",
    "\n",
    "# Colunas numericas: histogramas\n",
    "numeric_cols = df_train.select_dtypes(include=[np.number]).columns.tolist()\n",
    "df_train[numeric_cols].hist(bins=20, figsize=(15, 10))\n",
    "plt.suptitle(\"3.1 - Histogramas das colunas numericas\")\n",
    "plt.show()\n",
    "\n",
    "# Colunas de ano guardadas como texto: extrair o ano e tratar como numerico\n",
    "year_num = pd.DataFrame({c: parse_year(df_train[c]) for c in YEAR_COLS if c in df_train.columns})\n",
    "print(\"\\n3.1 - Colunas de ano (intervalo observado depois de extrair o ano)\")\n",
    "display(year_num.describe().T[['min', 'max', 'count']])\n",
    "year_num.hist(bins=30, figsize=(14, 4), layout=(1, len(year_num.columns)))\n",
    "plt.suptitle(\"3.1 - Distribuicao dos anos\")\n",
    "plt.show()\n",
    "\n",
    "# Categoricas de baixa cardinalidade: grafico de barras\n",
    "low_card = ['Quadrant', 'AllMusic Extraction Date']\n",
    "fig, axes = plt.subplots(1, len(low_card), figsize=(12, 4))\n",
    "for ax, col in zip(np.atleast_1d(axes), low_card):\n",
    "    df_train[col].value_counts(dropna=False).plot.bar(ax=ax)\n",
    "    ax.set_title(\"3.1 - \" + col)\n",
    "    ax.set_ylabel(\"n de musicas\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Colunas de etiquetas (multi-label): a distribuicao real e por etiqueta individual\n",
    "print(\"\\n3.1 - Colunas de etiquetas: n de etiquetas distintas e n por musica\")\n",
    "tag_summary = []\n",
    "fig, axes = plt.subplots(1, len(TAG_COLS), figsize=(20, 4))\n",
    "for ax, col in zip(np.atleast_1d(axes), TAG_COLS):\n",
    "    tags = split_tags(df_train[col])\n",
    "    per_song = df_train[col].dropna().astype(str).str.split(',').apply(len)\n",
    "    tag_summary.append({'Coluna': col,\n",
    "                        'Etiquetas distintas': tags.nunique(),\n",
    "                        'Media de etiquetas por musica': round(per_song.mean(), 2)})\n",
    "    tags.value_counts().head(15).plot.barh(ax=ax)\n",
    "    ax.invert_yaxis()\n",
    "    ax.set_title(\"3.1 - \" + col + \": top 15\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "display(pd.DataFrame(tag_summary))\n",
    "\n",
    "# Identificadores: sem distribuicao util, so cardinalidade\n",
    "print(\"\\n3.1 - Colunas identificadoras (quase unicas por linha)\")\n",
    "display(df_train[ID_COLS].nunique().rename(\"Valores unicos\").to_frame())\n",
    "\n",
    "# Matriz de dispersao sobre colunas numericas reais, colorida pelo alvo\n",
    "pair_df = df_train[['Duration', 'Relevance']].apply(pd.to_numeric, errors='coerce').copy()\n",
    "pair_df['AnoReal'] = parse_year(df_train['ActualYear'])\n",
    "pair_df['Quadrant'] = df_train['Quadrant']\n",
    "sns.pairplot(pair_df.dropna(), hue='Quadrant', corner=True)\n",
    "plt.suptitle(\"3.1 - Matriz de dispersao (numericas reais)\", y=1.02)\n",
    "plt.show()\n",
    "\n",
    "# ==================================================================\n",
    "# 3.2 - Colunas quase vazias / quase constantes / mal rotuladas\n",
    "# ==================================================================\n",
    "diagnosis = []\n",
    "for col in df_train.columns:\n",
    "    miss = df_train[col].isna().mean() * 100\n",
    "    vc = df_train[col].value_counts(normalize=True, dropna=True)\n",
    "    top_freq = vc.iloc[0] * 100 if len(vc) else 100.0\n",
    "    flags = []\n",
    "    if miss >= 90:\n",
    "        flags.append('quase vazia')\n",
    "    if top_freq >= 95:\n",
    "        flags.append('quase constante')\n",
    "    if flags:\n",
    "        diagnosis.append({'Coluna': col, 'Missing (%)': round(miss, 1),\n",
    "                          'Valor dominante (%)': round(top_freq, 1),\n",
    "                          'Diagnostico': ', '.join(flags)})\n",
    "print(\"3.2 - Colunas quase vazias ou quase constantes\")\n",
    "display(pd.DataFrame(diagnosis))\n",
    "\n",
    "# \"mede algo diferente do que o nome diz\": Duration mistura unidades\n",
    "dur = pd.to_numeric(df_train['Duration'], errors='coerce').dropna()\n",
    "unit_buckets = pd.cut(dur, bins=[-np.inf, 10, 1000, 100000, np.inf],\n",
    "                      labels=['< 10 (minutos?)', '10-1000 (segundos)',\n",
    "                              '1000-100000 (?)', '> 100000 (milissegundos?)'])\n",
    "print(\"\\n3.2 - 'Duration' diz segundos mas mistura unidades:\")\n",
    "display(unit_buckets.value_counts().sort_index().to_frame('n de musicas'))\n",
    "\n",
    "# Lista de colunas a descartar, com o motivo\n",
    "discard = {**{c: 'identificador / administrativo' for c in ID_COLS + ['AllMusic Extraction Date', 'Sample']},\n",
    "           'Valence': 'alvo (define o quadrante) - fuga',\n",
    "           'Arousal': 'alvo (define o quadrante) - fuga',\n",
    "           'Moods': 'etiquetas usadas para calcular o alvo - fuga',\n",
    "           'MoodsAll': 'etiquetas usadas para calcular o alvo - fuga',\n",
    "           'MoodsAllWeights': 'pesos das etiquetas de humor - fuga',\n",
    "           'Themes': 'sobreposicao semantica com o humor - fuga potencial',\n",
    "           'num_Genres': 'quase vazia (98,9%)',\n",
    "           'num_MoodsAll': 'quase vazia (98,9%)'}\n",
    "print(\"\\n3.2 - Colunas a descartar, com o motivo\")\n",
    "display(pd.DataFrame({'Coluna': list(discard), 'Motivo': list(discard.values())}))\n",
    "\n",
    "# ==================================================================\n",
    "# 3.5 - Artistas  (necessario em 8: validacao cruzada artist-disjoint)\n",
    "# ==================================================================\n",
    "print(\"3.5 - Artistas\")\n",
    "\n",
    "# contagem sem normalizar (como estava)\n",
    "print(\"[sem normalizar] artistas unicos no treino:\", df_train['Artist'].nunique())\n",
    "\n",
    "# normalizar AQUI, para que a estrutura de grupos usada na CV artist-disjoint esteja correta\n",
    "artist_train_norm = df_train['Artist'].astype(str).str.strip().str.lower()\n",
    "artist_test_norm  = df_test['Artist'].astype(str).str.strip().str.lower()\n",
    "artist_counts = artist_train_norm.value_counts()\n",
    "\n",
    "print(\"[normalizado]  artistas unicos no treino:\", artist_counts.shape[0],\n",
    "      \"(colapsaram\", df_train['Artist'].nunique() - artist_counts.shape[0], \"grafias)\")\n",
    "print(\"Media de musicas por artista: {:.2f}  |  maximo: {} ({})\".format(\n",
    "      artist_counts.mean(), artist_counts.iloc[0], artist_counts.index[0]))\n",
    "\n",
    "# artistas partilhados na fronteira de teste, com nomes normalizados\n",
    "shared = set(artist_train_norm) & set(artist_test_norm)\n",
    "n_shared = artist_test_norm.isin(shared).sum()\n",
    "print(\"Musicas de teste que partilham artista com o treino (normalizado): {} de {} ({:.0f}%)\".format(\n",
    "      n_shared, len(df_test), 100 * n_shared / len(df_test)))\n",
    "\n",
    "# grafico de barras: top 20 artistas + distribuicao de musicas por artista\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 5))\n",
    "artist_counts.head(20).plot.bar(ax=axes[0])\n",
    "axes[0].set_title(\"3.5 - Top 20 artistas por n de musicas (treino)\")\n",
    "axes[0].set_ylabel(\"n de musicas\")\n",
    "artist_counts.value_counts().sort_index().plot.bar(ax=axes[1])\n",
    "axes[1].set_title(\"3.5 - Distribuicao de musicas por artista\")\n",
    "axes[1].set_xlabel(\"musicas por artista\")\n",
    "axes[1].set_ylabel(\"n de artistas\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
